from django.urls import path
from .views import (
    InvestmentInitiateView,
    PaymentCallbackView,
    MyInvestmentsListView,
    InvestmentDetailView,
    InvestorPortfolioSummaryView,
    AdminPaymentTransactionListView,
    AdminPaymentTransactionDetailView
)

app_name = 'investments'

urlpatterns = [
    # Investor endpoints
    path(
        'initiate/',
        InvestmentInitiateView.as_view(),
        name='investment-initiate'
    ),
    path(
        'my/',
        MyInvestmentsListView.as_view(),
        name='my-investments'
    ),
    path(
        '<uuid:id>/',
        InvestmentDetailView.as_view(),
        name='investment-detail'
    ),
    path(
        'portfolio/summary/',
        InvestorPortfolioSummaryView.as_view(),
        name='portfolio-summary'
    ),
    
    # Payment gateway callback
    path(
        'payments/callback/',
        PaymentCallbackView.as_view(),
        name='payment-callback'
    ),
    
    # Admin endpoints
    path(
        'admin/transactions/',
        AdminPaymentTransactionListView.as_view(),
        name='admin-transactions'
    ),
    path(
        'admin/transactions/<uuid:id>/',
        AdminPaymentTransactionDetailView.as_view(),
        name='admin-transaction-detail'
    ),
]